---
import CommonHead from "../../src/components/common/CommonHead.astro";
import CommonHeader from "../../src/components/common/CommonHeader.astro";
import Footer from "../../src/components/footer/Footer.astro";
import BackButton from "../../src/components/patrician-publications/BackButton.astro";
import MobileNavButton from "../../src/components/common/MobileNavButton.astro";
import HTMX from "../../src/components/common/HTMX.astro";

import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/space-mono/400.css";
import "../../src/components/common/swup.css";
import Table from "../../src/components/author/Table.astro";

const { meta } = Astro.props;
---


<html lang="en">
<CommonHead
    title="Manage Content | SPC Media Unit"
/>

<body x-data="{open:false}" class="cursor-default bg-spc-dark text-spc-light font-sans">
<CommonHeader title="Manage Content | SPC Media Unit" />

<main>
    <section class="px-6 md:px-12 xl:px-96 ">
        <BackButton />
    </section>

    <section class="px-6 mt-8 md:px-12 xl:px-96 ">
        <h1 class="font-bold text-4xl leading-[95%]">Manage Content</h1>
    </section>

    <div class="px-96 my-8">
        <div class="flex justify-start items-baseline space-x-2">
            <a
                href="/home/be/projs/spc-175/temp-vault/author/new-blog"
                class="w-fit flex justify-start items-center space-x-2 bg-spc-light text-spc-green font-bold px-4 py-2 rounded-sm my-1 ">
            <span class="pr-2">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="size-6"
                >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M12 4.5v15m7.5-7.5h-15">
                        </path>
                </svg>
            </span>
                Create new blog
            </a>
        </div>

        <section class="mt-12">
            <h1 class="font-bold text-xl leading-[95%]">Contents</h1>
        </section>
        <div class="htmxenable my-4">
            <Table />
        </div>

        <section class="mt-12">
            <h1 class="font-bold text-xl leading-[95%]">Blogs</h1>
        </section>
        <div class="htmxenable my-4">
            <Table category="blogs" />
        </div>
    </div>

</main>
<Footer />
<MobileNavButton />

<HTMX />
</body>
</html>



