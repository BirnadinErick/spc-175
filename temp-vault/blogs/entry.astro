---
import Loader from "../../src/components/common/Loader.astro";
import CommonHead from "../../src/components/common/CommonHead.astro";
import CommonHeader from "../../src/components/common/CommonHeader.astro";
import Footer from "../../src/components/footer/Footer.astro";
import BackButton from "../../src/components/patrician-publications/BackButton.astro";
import MobileNavButton from "../../src/components/common/MobileNavButton.astro";
import HTMX from "../../src/components/common/HTMX.astro";

import { get_api_route } from "../../src/config/global";

import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/space-mono/400.css";
import "../../src/components/common/swup.css";
---

<html lang="en">
<CommonHead
    title="Patrician Publications | SPC Media Unit | 175 years"
/>

<body x-data="{open:false}" class="cursor-default bg-spc-dark text-spc-light font-sans">
<CommonHeader title="Patrician<br/>Publications" />

<section class="md:px-12 xl:px-96">
    <div class="px-6">
        <BackButton />
    </div>

    <div hx-get={get_api_route("read-blog-html")}
         hx-trigger="load"
         hx-swap="innerHTML">
        <Loader />
    </div>
</section>

<Footer />
<MobileNavButton />

<HTMX />

<script is:inline>
    document.body.addEventListener("htmx:configRequest", function(e) {
        const queryStr = window.location.search;
        const searchParams = new URLSearchParams(queryStr);
        e.detail.parameters["slug"] = searchParams.get("p");
    });
</script>
</body>
</html>
