---
import SPCLogo from "@components/common/SPCLogo.astro";
import { get_api_route } from "../../config/global";
const currentYear = new Date().getFullYear();
const quickNavLinks = [
    "Home", "Academics", "Blogs & News", "Our Spirituality", "Projects", "Our History",
    "Live Streams", "175 Celebrations", "Gallery", "Sports", "Contact Us"
];
---

<footer class="text-spc-light bg-spc-dark">
    <!-- Mobile Footer -->
    <div class="lg:hidden rounded-t-3xl">
        <div class="px-6 py-8 space-y-8">
            <div class="text-center">
                <div class="flex items-center justify-center">
                    <SPCLogo />
                </div>
                <h2 class="text-2xl font-semibold mb-2 mt-2">St. Patrick's College</h2>
                <p class="text-sm opacity-80">Jaffna</p>
            </div>
            <nav>
                <ul class="flex text-sm flex-wrap justify-center gap-4">
                    <li><a href="/" class="hover:text-spc-gold transition-colors">Home</a></li>
                    <li><a href="/academics/news" class="hover:text-spc-gold transition-colors">Academics</a>
                    </li>
                    <li><a href="/blogs" class="hover:text-spc-gold transition-colors">Blogs & News</a></li>
                    <li><a href="/alma-mater/our-spirituality" class="hover:text-spc-gold transition-colors">Our
                        Spirituality</a></li>
                    <li><a href="/projects" class="hover:text-spc-gold transition-colors">Projects</a></li>
                    <li><a href="/alma-mater/history-of-the-college"
                           class="hover:text-spc-gold transition-colors">Our History</a></li>
                    <li><a href="https://www.youtube.com/@st.patrickscollegejaffna.8326/streams" target="_blank"
                           class="hover:text-spc-gold transition-colors">Live Streams</a></li>
                    <li><a href="https://spc175.com/" target="_blank"
                           class="hover:text-spc-gold transition-colors">175 Celebrations</a></li>
                    <li><a href="/gallery" class="hover:text-spc-gold transition-colors">Gallery</a></li>
                    <li><a href="/co-curriculum/sports" class="hover:text-spc-gold transition-colors">Sports</a>
                    </li>
                </ul>
            </nav>
            <p class="mt-2"><a target="_blank"
                               href="https://www.google.de/maps/place/St.+Patrick's+College,+Jaffna/@9.6551515,80.0187737,17z/data=!3m1!4b1!4m6!3m5!1s0x3afe56bad7689735:0x4428bae8d47fa23f!8m2!3d9.6551515!4d80.0213486!16s%2Fm%2F05p2xx9?entry=ttu&g_ep=EgoyMDI1MDIwNS4xIKXMDSoASAFQAw%3D%3D">St.
                Patrick's College,<br />St. Patrick's Road,<br />40 000 Jaffna</a></p>
            <div class="text-center text-sm space-y-2">
                <p><a href="mailto:info@spcjaffna.org">info@spcjaffna.org</a></p>
                <p><a href="tel:0212222388">0212222388</a></p>
            </div>
            <div class="flex justify-center space-x-6">
                <a href="https://www.facebook.com/StPatricksCollegeJaffna/"
                   class="text-spc-light hover:text-spc-gold transition-colors">
                    <span class="sr-only">Facebook</span>
                    <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill-rule="evenodd"
                              d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
                              clip-rule="evenodd" />
                    </svg>
                </a>
                <a href="https://www.youtube.com/@st.patrickscollegejaffna.8326"
                   class="text-spc-light hover:text-spc-gold transition-colors">
                    <span class="sr-only">YouTube</span>
                    <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill-rule="evenodd"
                              d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z"
                              clip-rule="evenodd" />
                    </svg>
                </a>
            </div>
        </div>
        <div class="rounded-t-3xl px-6 py-8 space-y-4">
            <p class="text-xs text-center opacity-70">All rights reserved by SPC Media Unit. Neither code nor graphics
                can be used without prior written knowledge of the Unit Members.</p>
            <p class="text-xs text-center opacity-70">Source text is owned by the members of 2022's SPC Media Unit.</p>
            <div class="w-20 h-1 bg-spc-gold mx-auto rounded-full"></div>
            <p class="text-xs text-center">Proudly developed in Deggendorf and Jaffna, by SPC Media Unit 2022.</p>
            <p class="text-xs text-center opacity-70">&copy; {currentYear} SPC Media Unit</p>
        </div>
    </div>

    <!-- Desktop Footer -->
    <div class="hidden lg:block">
        <div class="max-w-7xl mx-auto px-6 py-12">
            <div class="rounded-3xl shadow-lg overflow-hidden">
                <div class="grid grid-cols-4 gap-8 p-8">
                    <div class="col-span-2 space-y-6">
                        <div class="flex items-center space-x-4">
                            <div>
                                <SPCLogo />
                            </div>
                            <div>
                                <h2 class="text-2xl font-semibold">St. Patrick's College</h2>
                                <p class="text-sm opacity-80">Jaffna</p>
                            </div>
                        </div>
                        <h3 class="text-xl font-semibold mb-2">Quick Navigation</h3>
                        <ul class="grid grid-cols-2 gap-2">
                            <li><a href="/" class="hover:text-spc-gold transition-colors">Home</a></li>
                            <li><a href="/academics/news" class="hover:text-spc-gold transition-colors">Academics</a>
                            </li>
                            <li><a href="/blogs" class="hover:text-spc-gold transition-colors">Blogs & News</a></li>
                            <li><a href="/alma-mater/our-spirituality" class="hover:text-spc-gold transition-colors">Our
                                Spirituality</a></li>
                            <li><a href="/projects" class="hover:text-spc-gold transition-colors">Projects</a></li>
                            <li><a href="/alma-mater/history-of-the-college"
                                   class="hover:text-spc-gold transition-colors">Our History</a></li>
                            <li><a href="https://www.youtube.com/@st.patrickscollegejaffna.8326/streams" target="_blank"
                                   class="hover:text-spc-gold transition-colors">Live Streams</a></li>
                            <li><a href="https://spc175.com/" target="_blank"
                                   class="hover:text-spc-gold transition-colors">175 Celebrations</a></li>
                            <li><a href="/gallery" class="hover:text-spc-gold transition-colors">Gallery</a></li>
                            <li><a href="/co-curriculum/sports" class="hover:text-spc-gold transition-colors">Sports</a>
                            </li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold mb-4">Contact Us</h3>
                        <p><a href="mailto:info@spcjaffna.org">info@spcjaffna.org</a></p>
                        <p><a href="tel:0212222388">0212222388</a></p>
                        <p class="mt-2"><a target="_blank"
                                           href="https://www.google.de/maps/place/St.+Patrick's+College,+Jaffna/@9.6551515,80.0187737,17z/data=!3m1!4b1!4m6!3m5!1s0x3afe56bad7689735:0x4428bae8d47fa23f!8m2!3d9.6551515!4d80.0213486!16s%2Fm%2F05p2xx9?entry=ttu&g_ep=EgoyMDI1MDIwNS4xIKXMDSoASAFQAw%3D%3D">St.
                            Patrick's College,<br />St. Patrick's Road,<br />40 000 Jaffna</a></p>
                        <div class="mt-6 flex space-x-4">
                            <a href="https://www.facebook.com/StPatricksCollegeJaffna/"
                               class="text-spc-light hover:text-spc-gold transition-colors">
                                <span class="sr-only">Facebook</span>
                                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path fill-rule="evenodd"
                                          d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
                                          clip-rule="evenodd" />
                                </svg>
                            </a>
                            <a href="https://www.youtube.com/@st.patrickscollegejaffna.8326"
                               class="text-spc-light hover:text-spc-gold transition-colors">
                                <span class="sr-only">YouTube</span>
                                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path fill-rule="evenodd"
                                          d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z"
                                          clip-rule="evenodd" />
                                </svg>
                            </a>
                        </div>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold mb-4">Feedback</h3>
                        <form class="htmxenable space-y-4" hx-post={get_api_route("feedback")} hx-target="#feedback-button" hx-swap="outerHTML">
                            <div>
                                <label for="email" class="block text-sm font-medium mb-1">Email</label>
                                <input type="email" id="email" name="email" required
                                       class="w-full px-3 py-2 bg-spc-light/10 rounded-md focus:outline-none focus:ring-2 focus:ring-spc-gold" />
                            </div>
                            <div>
                                <label for="message" class="block text-sm font-medium mb-1">Message</label>
                                <textarea id="message" name="message" rows="4" required
                                          class="w-full px-3 py-2 bg-spc-light/10 rounded-md focus:outline-none focus:ring-2 focus:ring-spc-gold"></textarea>
                            </div>
                            <button type="submit"
                                    id="feedback-button"
                                    class="inline-block px-6 py-2 bg-transparent text-spc-gold font-bold rounded-full border-2 border-spc-gold hover:bg-spc-gold/10 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1 text-center text-lg">
                                Send Feedback
                            </button>
                        </form>
                    </div>
                </div>
                <div class="border-t border-spc-light/20 p-8">
                    <div class="flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
                        <div class="text-center sm:text-left">
                            <p>&copy; {currentYear} SPC Media Unit. All rights reserved.</p>
                            <p class="mt-1 text-sm opacity-70">Neither code nor graphics can be used without prior
                                written knowledge of the Unit Members.</p>
                            <p class="mt-1 text-sm opacity-70">Source text is owned by the members of 2022's SPC Media
                                Unit.</p>
                        </div>
                        <div class="text-center sm:text-right">
                            <p>Proudly developed in Jaffna and Deggendorf,</p>
                            <p>by SPC Media Unit 2022.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>