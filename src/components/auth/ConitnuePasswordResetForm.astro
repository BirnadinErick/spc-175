---
import TextInput from "../common/TextInput.astro";

import { get_api_route } from "../../config/global";
---

<form class="htmxenable"
      method="post"
      hx-post={get_api_route("complete-password-reset", "v2")}
      hx-vals='js:{ code: new URLSearchParams(window.location.search).get("code") }'
      hx-swap="outerHTML">
    <TextInput type="password" id="new_password" label="New Password" />
    <TextInput type="password" id="new_password_repeat" label="Repeat New Password" />

    <div class="flex justify-end space-x-6 items-center">
        <button
            class="font-bold px-4 py-2 bg-white text-spc-green"
            type="submit">Complete password reset.
        </button>
    </div>
    <a href="/auth/login" class="underline underline-offset-4">Remember the password? Log in then.</a>
</form>
