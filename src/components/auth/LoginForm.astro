---
import TextInput from "../common/TextInput.astro";

import { get_api_route } from "../../config/global";
---

<form class="htmxenable" method="post" hx-post={get_api_route("login-user", "v2")} hx-swap="outerHTML"
      hx-select-oob="#navbar-auth:innerHTML, #navbar-auth-mobile:innerHTML"
>
    <TextInput type="email" id="email" label="Email Address" />

    <TextInput type="password" id="password" label="Password" />

    <div class="flex justify-end space-x-6 items-center">
        <a href="/auth/password-reset" class="text-spc-gold hover:underline hover:underline-offset-2">
            Forgot Password?
        </a>

        <button
            class="font-bold px-4 py-2 bg-white text-spc-green"
            type="submit">Log In
        </button
        >
    </div>
    <a href="/auth/signin" class="underline underline-offset-4">New? Register here.</a>
</form>
