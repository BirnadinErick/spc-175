---
import { get_api_route } from "../../config/global";
import TextInput from "../common/TextInput.astro";
---

<form hx-post={get_api_route("update-project", "v2")} hx-swap="outerHTML">
    <div class="htmxenable" hx-trigger="load" hx-swap="outerHTML" hx-get={get_api_route("project-edit-form", "v2")}>
        <span class="animate-pulse font-bold">Loading, please wait...</span>
    </div>
</form>

<script >
    document.body.addEventListener("htmx:beforeSwap", function(evt) {
        if (evt.detail.xhr.status === 303) {
            window.location = '/projects/admin';
        }
    });
</script>
